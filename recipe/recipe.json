{
  "schema": 2,
  "id": "edgesonic",
  "name": "EdgeSonic",
  "summary": {
    "en": "A Subsonic-compatible music server running entirely on Cloudflare Workers, D1 and R2.",
    "zh-CN": "完全运行在 Cloudflare Workers、D1 与 R2 上的 Subsonic 兼容音乐服务。"
  },
  "homepage": "https://github.com/Wuyilingwei/EdgeSonic",
  "issues": {
    "url": "https://github.com/wuyilingwei/edgesonic/issues/new"
  },
  "version": "0.0.0-dev",
  "tag": "v0.0.0-dev",
  "buildTime": "1970-01-01T00:00:00Z",
  "package": {
    "artifact": "overture.tar.gz",
    "sha256": ""
  },
  "license": {
    "id": "AGPL-3.0-or-later",
    "text": ""
  },
  "terms": {
    "texts": {
      "zh-CN": "",
      "*": ""
    },
    "required": true
  },
  "authModes": [
    "auto"
  ],
  "permissions": [
    {
      "key": "scripts",
      "requirement": "required",
      "oauthScopes": [
        "workers-scripts.write",
        "workers-scripts.bind",
        "workers-scripts.read"
      ],
      "scope": "account",
      "level": "write",
      "label": {
        "en": "Workers Scripts",
        "zh-CN": "Workers Scripts"
      },
      "scenario": {
        "en": "Deploy the Worker, assets, Secrets, and Cron",
        "zh-CN": "部署 Worker、资源、Secrets 和 Cron"
      }
    },
    {
      "key": "d1",
      "requirement": "required",
      "oauthScopes": [
        "d1.write",
        "d1.read"
      ],
      "scope": "account",
      "level": "write",
      "label": {
        "en": "D1",
        "zh-CN": "D1"
      },
      "scenario": {
        "en": "Create the database and apply its schema",
        "zh-CN": "创建数据库并写入数据库结构"
      }
    },
    {
      "key": "r2",
      "requirement": "required",
      "oauthScopes": [
        "workers-r2.write",
        "workers-r2.read"
      ],
      "scope": "account",
      "level": "write",
      "label": {
        "en": "Workers R2 Storage",
        "zh-CN": "Workers R2 Storage"
      },
      "scenario": {
        "en": "Create and list the music bucket",
        "zh-CN": "创建和列出音乐存储桶"
      }
    },
    {
      "key": "domains",
      "requirement": "optional",
      "oauthScopes": [
        "workers-routes.read",
        "workers-routes.write",
        "zone.read"
      ],
      "scope": "account",
      "level": "write",
      "label": {
        "en": "Workers Routes",
        "zh-CN": "Workers Routes"
      },
      "scenario": {
        "en": "Attach the custom domain you choose, if you choose one",
        "zh-CN": "绑定你指定的自定义域名（不填则不使用）"
      }
    },
    {
      "key": "r2_keys",
      "requirement": "optional",
      "oauthScopes": [],
      "scope": "allBuckets",
      "level": "readWrite",
      "label": {
        "en": "R2 S3 API Key",
        "zh-CN": "R2 S3 API Key"
      },
      "scenario": {
        "en": "R2 presigned direct playback",
        "zh-CN": "R2 预签名直连播放"
      }
    },
    {
      "key": "ci",
      "requirement": "optional",
      "oauthScopes": [
        "workers-ci.write"
      ],
      "scope": "account",
      "level": "write",
      "label": {
        "en": "Workers CI",
        "zh-CN": "Workers CI"
      },
      "scenario": {
        "en": "In-app CI integration",
        "zh-CN": "应用内 CI 集成"
      }
    },
    {
      "key": "containers",
      "requirement": "optional",
      "oauthScopes": [
        "containers.write",
        "containers.read"
      ],
      "scope": "account",
      "level": "write",
      "label": {
        "en": "Workers Containers",
        "zh-CN": "Workers Containers"
      },
      "scenario": {
        "en": "Container transcoding",
        "zh-CN": "容器转码"
      }
    },
    {
      "key": "observability",
      "requirement": "optional",
      "oauthScopes": [
        "workers-observability.write"
      ],
      "scope": "account",
      "level": "write",
      "label": {
        "en": "Workers Observability",
        "zh-CN": "Workers Observability"
      },
      "scenario": {
        "en": "Worker logs and observability troubleshooting",
        "zh-CN": "Worker 日志与可观测性排障"
      }
    },
    {
      "key": "account_analytics",
      "requirement": "optional",
      "oauthScopes": [
        "account-analytics.read"
      ],
      "scope": "account",
      "level": "read",
      "label": {
        "en": "Account Analytics",
        "zh-CN": "Account Analytics"
      },
      "scenario": {
        "en": "In-app request, error, and CPU analytics",
        "zh-CN": "应用内请求量、错误和 CPU 分析"
      }
    },
    {
      "key": "account_settings",
      "requirement": "optional",
      "oauthScopes": [
        "account-settings.read"
      ],
      "scope": "account",
      "level": "read",
      "label": {
        "en": "Account Settings",
        "zh-CN": "Account Settings"
      },
      "scenario": {
        "en": "In-app Cloudflare connection checks",
        "zh-CN": "应用内 Cloudflare 连接检测"
      }
    }
  ],
  "checks": [
    {
      "id": "r2",
      "requirement": "required",
      "path": "/accounts/${accountId}/r2/buckets",
      "label": {
        "en": "R2 storage is enabled",
        "zh-CN": "已启用 R2 存储"
      },
      "hint": {
        "en": "R2 isn't enabled on this account yet. Open the R2 dashboard and activate it; Cloudflare shows any billing requirement before you confirm.",
        "zh-CN": "此账号尚未启用 R2。请打开 R2 控制台激活；确认前 Cloudflare 会显示任何账单要求。"
      },
      "actionUrl": "https://dash.cloudflare.com/?to=/:account/r2"
    },
    {
      "id": "images",
      "requirement": "optional",
      "path": "/accounts/${accountId}/images/v1/stats",
      "label": {
        "en": "Cloudflare Images transformations",
        "zh-CN": "Cloudflare Images 图片转换"
      },
      "hint": {
        "en": "Optional. Lets EdgeSonic resize cover art on demand; without it covers are served at original size.",
        "zh-CN": "可选。可让 EdgeSonic 按需缩放封面图；不启用时封面按原始尺寸提供。"
      },
      "actionUrl": "https://dash.cloudflare.com/?to=/:account/images"
    },
    {
      "id": "containers",
      "requirement": "required",
      "path": "/accounts/${accountId}/containers/applications",
      "label": {
        "en": "Workers Containers is available",
        "zh-CN": "Workers Containers 可用"
      },
      "hint": {
        "en": "The account must expose the Containers application API before the optional transcoding container can be declared.",
        "zh-CN": "只有账号开放 Containers 应用 API 后，才能声明可选的转码容器。"
      }
    }
  ],
  "resources": [
    {
      "id": "db",
      "kind": "d1",
      "binding": "DB",
      "defaultName": "${worker}-db",
      "required": true,
      "match": {
        "names": [
          "edgesonic-db"
        ],
        "patterns": [
          "^edgesonic(?:-[a-z0-9]+)*-db$"
        ]
      },
      "label": {
        "en": "Library database",
        "zh-CN": "曲库数据库"
      },
      "help": {
        "en": "D1 database name. An existing database with this name is reused as-is, so make sure it is empty or belongs to the instance you mean to recover.",
        "zh-CN": "D1 数据库名称。同名数据库会被直接复用，请确认它是空库或属于本次要恢复的实例。"
      }
    },
    {
      "id": "music",
      "kind": "r2",
      "binding": "MUSIC_BUCKET",
      "defaultName": "${worker}-storage",
      "required": true,
      "s3Keys": "optional",
      "match": {
        "names": [
          "edgesonic-storage",
          "edgesonic-music"
        ],
        "patterns": [
          "^edgesonic(?:-[a-z0-9]+)*-(?:storage|music)$"
        ]
      },
      "label": {
        "en": "Music storage",
        "zh-CN": "音乐存储"
      },
      "help": {
        "en": "R2 bucket name — this is where uploaded music lives. Adding the optional S3 key pair enables presigned direct playback; without it playback goes through the Worker.",
        "zh-CN": "R2 存储桶名称——上传的音乐存放在这里。填写可选的 S3 密钥对可启用预签名直连播放；不填则通过 Worker 代理播放。"
      }
    }
  ],
  "worker": {
    "defaultName": "edgesonic",
    "module": "worker/index.js",
    "assetsManifest": "assets-manifest.json",
    "assetsDir": "assets",
    "assetHeaders": "assets/_headers",
    "assetsBinding": "ASSETS",
    "compatibilityDate": "2025-05-24",
    "compatibilityFlags": [
      "nodejs_compat"
    ],
    "vars": [
      {
        "name": "R2_BUCKET_NAME",
        "value": "${resource:music}"
      },
      {
        "name": "INSTANCE_ID",
        "value": "${uuid}"
      },
      {
        "name": "MAX_PROXY_DEPTH",
        "value": "3"
      },
      {
        "name": "WORKER_VERSION",
        "value": "${version}"
      },
      {
        "name": "EDGESONIC_VERSION",
        "value": "${version}"
      },
      {
        "name": "EDGESONIC_BUILD_TIME",
        "value": "${buildTime}"
      },
      {
        "name": "WORKER_NAME",
        "value": "${worker}"
      }
    ],
    "containers": [
      {
        "className": "Sandbox",
        "mode": "ask",
        "image": {
          "reference": "docker.io/wuyilingwei/edgesonic-transcoder@sha256:__BUILD_IMAGE_DIGEST__"
        },
        "note": {
          "en": "Transcoding runs in this container. This release publishes the matching pre-built image, and the deployment pins its immutable digest when the container is enabled.",
          "zh-CN": "转码运行在该容器中。本版本会发布对应的预构建镜像；启用容器时，部署将固定使用该镜像的不可变摘要。"
        }
      }
    ]
  },
  "inputs": [
    {
      "id": "reset_admin",
      "kind": "toggle",
      "default": false,
      "onlyMode": "overwrite",
      "label": {
        "en": "Reset the superadmin account",
        "zh-CN": "重置超级管理员账号"
      },
      "help": {
        "en": "Off by default: an overwrite leaves the existing superadmin untouched. Turn this on only when you need to issue new credentials.",
        "zh-CN": "默认关闭：覆盖安装会保留已有的超级管理员。仅在需要签发新凭据时开启。"
      }
    },
    {
      "id": "admin_username",
      "kind": "text",
      "default": "admin",
      "required": true,
      "visibleWhen": {
        "input": "reset_admin",
        "equals": true,
        "mode": "overwrite"
      },
      "label": {
        "en": "Superadmin username",
        "zh-CN": "超级管理员用户名"
      },
      "help": {
        "en": "Defaults to \"admin\". Any username is supported, including Chinese and other non-Latin scripts.",
        "zh-CN": "默认为 “admin”。支持任意用户名，包括中文等非拉丁文字。"
      }
    },
    {
      "id": "admin_password",
      "kind": "password",
      "visibleWhen": {
        "input": "reset_admin",
        "equals": true,
        "mode": "overwrite"
      },
      "label": {
        "en": "Superadmin password",
        "zh-CN": "超级管理员密码"
      },
      "help": {
        "en": "Leave empty to generate a random password. It is shown once on the final page and never saved in plaintext.",
        "zh-CN": "留空会生成随机密码。密码仅在最后一页显示一次，绝不会以明文保存。"
      }
    },
    {
      "id": "domain",
      "kind": "domain",
      "required": false,
      "label": {
        "en": "Custom domain",
        "zh-CN": "自定义域名"
      },
      "help": {
        "en": "Optional. Leave empty to use the *.workers.dev hostname.",
        "zh-CN": "可选。留空则使用 *.workers.dev 域名。"
      }
    }
  ],
  "capabilities": [
    "d1",
    "r2",
    "secrets",
    "worker",
    "assets",
    "cron",
    "domains",
    "probe"
  ],
  "hostSecrets": [
    {
      "name": "CF_ACCOUNT_ID",
      "source": "accountId",
      "requirement": "required",
      "reason": {
        "en": "The instance calls its own account's API for in-app updates and for container transcoding, which needs the account id alongside the token.",
        "zh-CN": "实例的自更新与容器转码要调用本账号自身的 API，除令牌外还需要账号 ID。"
      }
    },
    {
      "name": "CF_API_TOKEN",
      "source": "cfApiToken",
      "requirement": "required",
      "placeholder": {
        "en": "cfat_…",
        "zh-CN": "cfat_…"
      },
      "reason": {
        "en": "In-app self-update uploads a new Worker version, and container transcoding provisions its own resources — both act on this account with this token.",
        "zh-CN": "应用内自更新要上传新的 Worker 版本，容器转码要开通自身资源——两者都用这个令牌操作本账号。"
      },
      "permissions": [
        {
          "key": "workers_scripts",
          "type": "edit",
          "requirement": "required",
          "scenario": {
            "en": "Deploy the app and let it update itself in place.",
            "zh-CN": "部署应用，并支持应用内自更新。"
          }
        },
        {
          "key": "d1",
          "type": "edit",
          "requirement": "required",
          "scenario": {
            "en": "Create the library database and apply its schema.",
            "zh-CN": "创建曲库数据库并初始化结构。"
          }
        },
        {
          "key": "workers_r2",
          "type": "edit",
          "requirement": "required",
          "scenario": {
            "en": "Create and reach the music storage bucket.",
            "zh-CN": "创建并访问音乐存储桶。"
          }
        },
        {
          "key": "containers",
          "type": "edit",
          "requirement": "optional",
          "scenario": {
            "en": "Container transcoding — an optional feature you can leave out.",
            "zh-CN": "容器转码——可选功能，不需要可以不勾。"
          }
        },
        {
          "key": "containers",
          "type": "read",
          "requirement": "optional",
          "scenario": {
            "en": "Read the current container declaration before preserving it during an overwrite.",
            "zh-CN": "覆盖现有 Worker 前读取当前容器声明，以便在选择“不变”时保持现状。"
          }
        },
        {
          "key": "workers_routes",
          "type": "edit",
          "requirement": "optional",
          "scenario": {
            "en": "Attach a custom domain you provide.",
            "zh-CN": "绑定你指定的自定义域名。"
          }
        },
        {
          "key": "zone",
          "type": "read",
          "requirement": "optional",
          "scenario": {
            "en": "Resolve the zone a custom domain sits in.",
            "zh-CN": "解析自定义域名所在的区域。"
          }
        },
        {
          "key": "workers_observability",
          "type": "edit",
          "requirement": "optional",
          "scenario": {
            "en": "Read the Worker's logs for in-app troubleshooting.",
            "zh-CN": "应用内查看 Worker 日志排障。"
          }
        },
        {
          "key": "account_analytics",
          "type": "read",
          "requirement": "optional",
          "scenario": {
            "en": "Show request, error, and CPU analytics in-app.",
            "zh-CN": "应用内展示请求量、错误和 CPU 分析。"
          }
        },
        {
          "key": "account_settings",
          "type": "read",
          "requirement": "optional",
          "scenario": {
            "en": "Check the Cloudflare connection from in-app.",
            "zh-CN": "应用内检测 Cloudflare 连接状态。"
          }
        }
      ]
    },
    {
      "name": "R2_ACCESS_KEY_ID",
      "source": "r2AccessKeyId",
      "requirement": "optional",
      "reason": {
        "en": "Signs presigned R2 URLs so players stream straight from storage instead of through the Worker.",
        "zh-CN": "用于签发 R2 预签名地址，让播放器直连存储而不经过 Worker。"
      }
    },
    {
      "name": "R2_SECRET_ACCESS_KEY",
      "source": "r2SecretAccessKey",
      "requirement": "optional",
      "reason": {
        "en": "The secret half of the same presigned-playback key pair.",
        "zh-CN": "同一组预签名播放密钥的私密部分。"
      }
    }
  ],
  "steps": [
    {
      "id": "d1",
      "weight": 1,
      "label": {
        "en": "Create or reuse D1 database",
        "zh-CN": "创建或复用 D1 数据库"
      }
    },
    {
      "id": "r2",
      "weight": 1,
      "label": {
        "en": "Create or reuse R2 bucket",
        "zh-CN": "创建或复用 R2 存储桶"
      }
    },
    {
      "id": "schema",
      "weight": 2,
      "label": {
        "en": "Apply database schema",
        "zh-CN": "应用数据库结构"
      }
    },
    {
      "id": "rebuild",
      "weight": 1,
      "optional": true,
      "label": {
        "en": "Delete the existing Worker",
        "zh-CN": "删除现有 Worker"
      }
    },
    {
      "id": "assets",
      "weight": 6,
      "label": {
        "en": "Upload static assets",
        "zh-CN": "上传静态资源"
      }
    },
    {
      "id": "worker",
      "weight": 4,
      "label": {
        "en": "Upload Worker version",
        "zh-CN": "上传 Worker 版本"
      }
    },
    {
      "id": "deploy",
      "weight": 2,
      "label": {
        "en": "Switch traffic to the new version",
        "zh-CN": "切换流量到新版本"
      }
    },
    {
      "id": "secrets",
      "weight": 2,
      "label": {
        "en": "Push required secrets",
        "zh-CN": "推送必需的密钥"
      }
    },
    {
      "id": "cron",
      "weight": 1,
      "label": {
        "en": "Restore scheduled tasks",
        "zh-CN": "恢复定时任务"
      }
    },
    {
      "id": "admin",
      "weight": 1,
      "optional": true,
      "label": {
        "en": "Create superadmin account",
        "zh-CN": "创建超级管理员账号"
      }
    },
    {
      "id": "health",
      "weight": 1,
      "optional": true,
      "label": {
        "en": "Health check",
        "zh-CN": "健康检查"
      }
    }
  ],
  "script": "recipe.js",
  "health": {
    "path": "/edgesonic/version"
  },
  "done": {
    "links": [
      {
        "label": {
          "en": "Open EdgeSonic",
          "zh-CN": "打开 EdgeSonic"
        },
        "href": "${url}"
      },
      {
        "label": {
          "en": "Worker in the Cloudflare dashboard",
          "zh-CN": "Cloudflare 控制台中的 Worker"
        },
        "href": "https://dash.cloudflare.com/${accountId}/workers/services/view/${worker}/production"
      },
      {
        "label": {
          "en": "R2 bucket in the Cloudflare dashboard",
          "zh-CN": "Cloudflare 控制台中的 R2 存储桶"
        },
        "href": "https://dash.cloudflare.com/${accountId}/r2/default/buckets/${resource:music}"
      }
    ],
    "notes": {
      "en": "Cloudflare can take up to about 2 minutes to apply the changes and switch traffic over, so the instance may not respond right away. LastFM, email delivery and other optional integrations are configured from EdgeSonic's own Settings after you log in.",
      "zh-CN": "Cloudflare 处理更改并完成切换最长可能需要约 2 分钟，实例可能不会立刻响应。LastFM、邮件发送等可选集成请在登录后于 EdgeSonic 自身的设置页中配置。"
    }
  }
}
