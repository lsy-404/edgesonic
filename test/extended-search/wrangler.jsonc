{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "edgesonic-search-local",
  "main": "../../worker/src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "INSTANCE_ID": "search-preview",
    "EDGESONIC_VERSION": "dev",
    "WORKER_VERSION": "dev",
    "R2_BUCKET_NAME": "edgesonic-search-local"
  },
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rest/*", "/tag/*", "/storage/*", "/edgesonic/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "edgesonic-search-local",
    "database_id": "00000000-0000-0000-0000-000000000001"
  }],
  "r2_buckets": [{"binding": "MUSIC_BUCKET", "bucket_name": "edgesonic-search-local"}],
  "ratelimits": [
    {"name": "AUTH_RATE_LIMITER", "namespace_id": "1", "simple": {"limit": 100, "period": 60}},
    {"name": "API_RATE_LIMITER", "namespace_id": "2", "simple": {"limit": 1200, "period": 60}}
  ]
}
