{
  "name": "edgesonic-mcp-runtime-test",
  "main": "../../worker/src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": { "INSTANCE_ID": "local-mcp-test" },
  "d1_databases": [{ "binding": "DB", "database_name": "mcp-test", "database_id": "00000000-0000-0000-0000-000000000001" }],
  "r2_buckets": [{ "binding": "MUSIC_BUCKET", "bucket_name": "mcp-test" }]
}
