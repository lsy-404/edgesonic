# Optional. This Worker serves its own /cf and /r2 routes at the same
# origin as the built frontend (see worker/index.ts), so the default
# (unset) is same-origin relative calls — nothing to configure for the
# normal deploy. Only set this if the frontend is hosted separately from
# the Worker it talks to (see CONTRACT.md §3 on the ALLOWED_ORIGINS
# allowlist that has to match on the Worker side too).
VITE_RELAY_URL=
